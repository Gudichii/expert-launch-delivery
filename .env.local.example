# Kopiraj u .env.local, popuni, nikad commitaj (.env.local je u .gitignore)

# Google service account — put do JSON ključa preuzetog iz Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# ID ciljanog Google Sheeta za status bazu (vidi CLAUDE.md sekcija 2 i 4)
GOOGLE_SHEETS_STATUS_SHEET_ID=

# ID root Drive foldera za sve klijente (/Klijenti/)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Claude API ključ
ANTHROPIC_API_KEY=
